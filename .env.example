# Copy to .env for local overrides. Never commit .env.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# SQLite database file, relative to the prisma/ folder. Never commit *.db.
DATABASE_URL="file:./worksim.db"

# Session cookie Secure flag: 'auto' enables it in production (HTTPS) only.
# Set to 'false' solely for testing a local production build over plain HTTP.
COOKIE_SECURE=auto

# Maximum registration/login attempts per IP per minute (in-memory, single instance).
AUTH_RATE_LIMIT=30

# Demo accounts created by `npm run db:seed` (development/demo only - change or
# disable in any real deployment). Password for the seeded demo accounts.
SEED_DEMO_PASSWORD=Worksim-demo-1

# Dev/demo convenience: when on, a learner who submits work without a mentor is
# assigned to the seeded demo mentor (mentor@worksim.dev), so a freshly
# registered account's submission shows up in the mentor queue during a
# walkthrough. 'auto' enables it in development only - production never creates
# mentor assignments from a request.
DEMO_AUTO_ASSIGN_MENTOR=auto

# Dev/demo convenience: when on, a learner who submits work shares their
# evidence with the seeded demo employer (employer@worksim.dev), so a freshly
# registered account's submission shows up in the employer evidence list during
# a walkthrough. 'auto' enables it in development only - production never
# creates evidence shares from a request (sharing stays consent-based).
DEMO_AUTO_SHARE_EVIDENCE=auto

# ---- AI provider (optional) ----------------------------------------------
# Gemini through its OpenAI-compatible Chat Completions endpoint. Leave
# AI_API_KEY empty to run the platform without AI: submissions, evaluation and
# evidence all work, and AI sections show a clear "unavailable" state. The key
# never leaves the server and is never sent to the browser.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# A low-cost Flash model is sufficient: the prompts send small structured
# context and ask for compact JSON feedback, not prose essays.
AI_MODEL=gemini-3.5-flash-lite
# Hard per-request timeout (ms). A slow provider must never pin a request.
AI_TIMEOUT_MS=30000
