# Copy to .env for local overrides. Never commit .env.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# SQLite database file, relative to the prisma/ folder. Never commit *.db.
DATABASE_URL="file:./worksim.db"

# Session cookie Secure flag: 'auto' enables it in production (HTTPS) only.
# Set to 'false' solely for testing a local production build over plain HTTP.
COOKIE_SECURE=auto

# Maximum registration/login attempts per IP per minute (in-memory, single instance).
AUTH_RATE_LIMIT=30

# Demo accounts created by `npm run db:seed` (development/demo only - change or
# disable in any real deployment). Password for the seeded demo accounts.
SEED_DEMO_PASSWORD=Worksim-demo-1
