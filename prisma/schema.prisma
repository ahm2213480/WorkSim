// WorkSim data model.
//
// SQLite for this assessment (zero-cost hosting, file-based, no server to
// operate). The schema only uses portable types, so moving to PostgreSQL later
// means changing the datasource block - nothing else.
//
// NOTE: SQLite has no native enum support in Prisma, so role/status values are
// stored as text and validated with zod at the API boundary (see server/env.ts,
// server/auth/routes.ts and the feature validators). Every legal value is
// documented in the comment next to the column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One user table for all roles; `role` gates what each account can access.
/// The public register endpoint always creates LEARNER accounts - staff roles
/// are provisioned via seeding/admin only, so the API can never grant a
/// privileged role from client input.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("LEARNER") // LEARNER | MENTOR | EMPLOYER | ADMIN
  locale       String   @default("EN") // EN | AR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         Session[]
  attempts         SimulationAttempt[]
  mentorReviews    MentorReview[]      @relation("MentorReviewsByMentor")
  mentorAssignments MentorAssignment[] @relation("MentorAssignments")
  assignedLearners MentorAssignment[]  @relation("AssignedLearners")
  evidenceGranted  EvidenceShare[]     @relation("EvidenceSharedByLearner")
  evidenceRedeemed EvidenceShare[]     @relation("EvidenceRedeemedByEmployer")
  coachReport      CoachReport?
}

/// Server-side session store. The browser holds an opaque random token in an
/// HttpOnly cookie; only the SHA-256 hash of the token is stored, so reading
/// the database does not allow replaying someone's login.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A playable simulation (e.g. the NovaShop frontend task). User-visible
/// content is stored as parallel En/Ar columns - two locales do not justify a
/// generic translation table.
model Simulation {
  id               String   @id @default(cuid())
  slug             String   @unique
  company          String
  roleTitleEn      String
  roleTitleAr      String
  titleEn          String
  titleAr          String
  summaryEn        String
  summaryAr        String
  briefEn          String
  briefAr          String
  estimatedMinutes Int
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks     SimulationTask[]
  materials SimulationMaterial[]
  events    SimulationEvent[]
  skills    SimulationSkill[]
  attempts  SimulationAttempt[]
}

/// The deliverable of a simulation: instructions, the shape of the expected
/// work product (fieldsJson) and the deterministic rubric (checklistJson)
/// used for scoring. Separate from Simulation so a simulation can grow more
/// than one task later without a migration of submissions.
model SimulationTask {
  id             String     @id @default(cuid())
  simulationId   String
  simulation     Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  order          Int
  titleEn        String
  titleAr        String
  instructionsEn String
  instructionsAr String
  /// Submission form definition: [{ key, kind, labelEn, labelAr, multiline }]
  fieldsJson     String
  /// Deterministic rubric: [{ key, weight, labelEn, labelAr, check... }]
  checklistJson  String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  attempts SimulationAttempt[]

  @@unique([simulationId, order])
}

/// Reference material the learner receives "on their desk" (bug report,
/// dataset, source code, screenshots, acceptance criteria). Narrative content
/// is bilingual (contentEn/contentAr); technical artifacts such as code and
/// datasets are language-neutral, so both columns hold the same payload there.
model SimulationMaterial {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  kind         String // BRIEF | BUG_REPORT | REQUIREMENTS | CODE | DATASET | MESSAGE | SCREENSHOT
  titleEn      String
  titleAr      String
  contentEn    String
  contentAr    String
  order        Int

  @@index([simulationId])
}

/// A timed, scenario-specific message delivered during a running attempt
/// (for example a manager message that changes the requirement). Events are
/// authored per simulation; delivery is computed by the server from
/// `triggerMinutes` (elapsed since attempt start) and recorded per attempt in
/// AttemptEvent, so "what the learner saw and when" becomes evidence.
model SimulationEvent {
  id             String     @id @default(cuid())
  simulationId   String
  /// Authoring key (e.g. "guest-checkout-update"). Rubric criteria reference
  /// this key, not the row id, so content stays readable and stable across
  /// re-seeding; the API maps keys to ids when serving an attempt.
  key            String
  simulation     Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  kind           String // MANAGER_MESSAGE | REQUIREMENT_CHANGE | CUSTOMER_FEEDBACK
  fromName       String
  fromRole       String?
  titleEn        String
  titleAr        String
  bodyEn         String
  bodyAr         String
  triggerMinutes Int
  order          Int

  deliveries AttemptEvent[]

  @@unique([simulationId, key])
  @@index([simulationId])
}

/// Reusable skill label (e.g. "Debugging"). Simulations declare which skills
/// they are designed to exercise; earned instances live in DemonstratedSkill.
model Skill {
  id     String @id @default(cuid())
  slug   String @unique
  nameEn String
  nameAr String

  simulationSkills   SimulationSkill[]
  demonstratedSkills DemonstratedSkill[]
}

/// Join table: a skill a simulation can demonstrate. `checklistKey` optionally
/// ties the skill to one deterministic rubric item of the task; the skill is
/// only recorded as demonstrated when that rubric item is met during
/// evaluation (or, when null, whenever the submission is evaluated).
model SimulationSkill {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  checklistKey String?

  @@unique([simulationId, skillId])
}

/// One learner's playthrough of one task. Unique per (user, task): starting an
/// already-started task resumes the same attempt, which keeps draft state,
/// submission and evaluation unambiguous. `draftJson` holds work in progress
/// keyed by the task's submission field keys.
///
/// `taskSnapshotJson` freezes the brief (instructions + submission fields, both
/// locales) as the learner received it. Evidence must stay truthful even if an
/// admin later edits the task in the catalog, so the evidence views read the
/// snapshot rather than the live row.
model SimulationAttempt {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulationId     String
  simulation       Simulation     @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  taskId           String
  task             SimulationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status           String         @default("ACTIVE") // ACTIVE | SUBMITTED | EVALUATED
  draftJson        String         @default("{}")
  taskSnapshotJson String         @default("{}")
  createdAt        DateTime       @default(now())
  lastSavedAt      DateTime?
  submittedAt      DateTime?

  submission      Submission?
  eventDeliveries AttemptEvent[]

  @@unique([userId, taskId])
  @@index([simulationId])
}

/// Evidence that a learner received a simulation event during an attempt.
/// Written once on first delivery; read state is part of the workspace UI.
model AttemptEvent {
  id          String            @id @default(cuid())
  attemptId   String
  attempt     SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventId     String
  event       SimulationEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveredAt DateTime          @default(now())

  @@unique([attemptId, eventId])
  @@index([attemptId])
}

/// Immutable work product. Approach and reaction to changes are captured in
/// workJson alongside deliverables; the server validates it against the snapshot.
model Submission {
  id          String            @id @default(cuid())
  attemptId   String            @unique
  attempt     SimulationAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  workJson    String
  submittedAt DateTime          @default(now())

  evaluation         Evaluation?
  aiFeedback         AIFeedback[]
  demonstratedSkills DemonstratedSkill[]
  mentorReviews      MentorReview[]
}

/// Objective checks only. Store the rubric version and per-criterion evidence;
/// a completeness check must never be presented as proof of technical correctness.
model Evaluation {
  id            String     @id @default(cuid())
  submissionId  String     @unique
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rubricVersion String
  score         Int
  maxScore      Int
  criteriaJson  String
  createdAt     DateTime   @default(now())
}

/// One cached advisory review per submission and requested locale. Failure is
/// recorded separately from feedback; objective evaluation does not depend on AI.
model AIFeedback {
  id            String     @id @default(cuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  locale        String // EN | AR
  status        String     @default("PENDING") // PENDING | READY | UNAVAILABLE
  inputHash     String
  promptVersion String
  model         String?
  feedbackJson  String?
  failureCode   String?
  requestedAt   DateTime   @default(now())
  completedAt   DateTime?
  updatedAt     DateTime   @updatedAt

  @@unique([submissionId, locale])
}

/// A skill claim backed by a particular submission and explicit evidence.
/// Learner identity is derived through the attempt, not duplicated here.
model DemonstratedSkill {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)
  basisJson    String
  createdAt    DateTime   @default(now())

  @@unique([submissionId, skillId])
  @@index([skillId])
}

/// Which learners a mentor may review. Assignments are provisioned by seeding
/// or an admin action only — no endpoint creates them from client input, so
/// review access can never be self-granted. Scoping is enforced inside every
/// mentor query (`attempt.user.assignedLearners`), never by post-filtering.
model MentorAssignment {
  id        String   @id @default(cuid())
  mentorId  String
  mentor    User     @relation("MentorAssignments", fields: [mentorId], references: [id], onDelete: Cascade)
  learnerId String
  learner   User     @relation("AssignedLearners", fields: [learnerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([mentorId, learnerId])
  @@index([learnerId])
}

/// Human oversight remains separate from the advisory AI review.
model MentorReview {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       User       @relation("MentorReviewsByMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  feedback     String
  status       String     @default("DRAFT") // DRAFT | COMPLETED
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([submissionId, mentorId])
  @@index([mentorId, status])
}

/// Learner grants a named employer access to their completed evidence.
/// No public bearer links or globally searchable private candidate profiles.
/// Access requires the employer role, this grant, and revokedAt == null.
model EvidenceShare {
  id         String    @id @default(cuid())
  learnerId  String
  learner    User      @relation("EvidenceSharedByLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  employerId String
  employer   User      @relation("EvidenceRedeemedByEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@unique([learnerId, employerId])
  @@index([employerId, revokedAt])
}

/// Latest coach result per learner. inputHash includes evidence and locale;
/// return cached advice only when that fingerprint still matches.
model CoachReport {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale        String // EN | AR
  status        String    @default("PENDING") // PENDING | READY | UNAVAILABLE
  inputHash     String
  promptVersion String
  model         String?
  feedbackJson  String?
  failureCode   String?
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt
}
